{
    "name": "Node.js & PostgreSQL",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.override.yml"
    ],
    "service": "backend-server",
    "workspaceFolder": "/workspaces/medusa-multi-store",

    // Required for rootless Podman on macOS to prevent file permission errors
    "runArgs": [
        "--userns=keep-id"
    ],

    // Forward Medusa API server (9000) and PostgreSQL (5432)
    "forwardPorts": [9000, 5432],

    // Install backend deps for local dev, then best-effort link the overlay
    // into src/. Everything here is non-mutating: manifests are restored after
    // `yarn add` (meilisearch lands in node_modules only), links/copy are
    // skipped when the target already exists. apps/ must stay byte-identical
    // to upstream — scripts/hooks/pre-commit blocks any staged change.
    "postCreateCommand": "cd apps/backend && yarn install && yarn add meilisearch@0.60.0 && git restore package.json yarn.lock && mkdir -p src && for d in /workspaces/medusa-multi-store/overlay/backend/src/*; do b=$(basename \"$d\"); [ -e \"src/$b\" ] || ln -sn \"$d\" \"src/$b\"; done; [ -e medusa-config.ts ] || cp /workspaces/medusa-multi-store/overlay/backend/medusa-config.ts ./medusa-config.ts",
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint"
            ]
        }
    },

    "remoteUser": "medusa"
}