# ===========================================================================
# Dokploy service: medusa-meilisearch   (Application, Dockerfile build)
#   Dockerfile Path : deploy/meilisearch/Dockerfile
#   Context Path    : .
#   Domain          : NONE - search engine must not be exposed publicly.
#
# Meilisearch is NOT a native Dokploy Database. Create it as an Application
# like the other container services in this project.
# ===========================================================================

# --- Runtime environment variables -----------------------------------------
# Generate with: openssl rand -base64 32
# This is the same key that goes into MEILISEARCH_API_KEY on BOTH backend
# services, and it authenticates Medusa's meilisearch module to the engine.
MEILI_MASTER_KEY=CHANGE_ME

# Production mode, no anonymous telemetry.
MEILI_ENV=production
MEILI_NO_ANALYTICS=true

# --- Volume ----------------------------------------------------------------
# Add an Empty Volume in the Dokploy UI that mounts /meili_data (the index
# lives there). A named volume survives redeploys.