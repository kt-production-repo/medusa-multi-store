# ===========================================================================
# Dokploy service: medusa-backend-server   (Application, Dockerfile build)
#   Dockerfile Path : deploy/backend/Dockerfile
#   Context Path    : .
#   Domain          : api.example.com  ->  container port 9000
# ===========================================================================

# --- Build Time Arguments (Environment tab -> Build Time Arguments) --------
# These are baked into the Medusa Admin bundle and cannot be set at runtime.
DISABLE_MEDUSA_ADMIN=false
MEDUSA_BACKEND_URL=https://api.example.com

# --- Runtime environment variables -----------------------------------------
NODE_ENV=production
PORT=9000

# This instance serves the API and the Admin dashboard.
MEDUSA_WORKER_MODE=server

# Copy the "Internal Connection URL" from the Dokploy Postgres service.
# Host is the Dokploy internal hostname, NOT localhost.
DATABASE_URL=postgres://medusa:CHANGE_ME@medusa-postgres:5432/medusa

# Set to true ONLY for an external managed DB that requires TLS.
DATABASE_SSL=false

# Copy the "Internal Connection URL" from the Dokploy Redis service.
REDIS_URL=redis://default:CHANGE_ME@medusa-redis:6379

# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# CORS. Comma-separated, no trailing slashes.
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://shop.example.com,https://api.example.com

# --- Optional first-boot helpers -------------------------------------------
# Creates the admin user on startup if it does not already exist.
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=CHANGE_ME

# Seed demo data on first boot. Set back to false after the first deploy.
MEDUSA_SEED=false
