# ===========================================================================
# Dokploy service: medusa-backend-worker   (Application, Dockerfile build)
#   Dockerfile Path : deploy/backend/Dockerfile
#   Context Path    : .
#   Domain          : NONE - this service must not be exposed publicly.
#
# Runs scheduled jobs, subscribers and workflow execution.
# Must share the SAME database, Redis and secrets as backend-server.
# ===========================================================================

# --- Build Time Arguments --------------------------------------------------
# Skips bundling the Admin dashboard: faster builds, smaller image.
DISABLE_MEDUSA_ADMIN=true

# --- Runtime environment variables -----------------------------------------
NODE_ENV=production
PORT=9000

# Background processing only.
MEDUSA_WORKER_MODE=worker

# Identical to backend-server.
DATABASE_URL=postgres://medusa:CHANGE_ME@medusa-postgres:5432/medusa
DATABASE_SSL=false
REDIS_URL=redis://default:CHANGE_ME@medusa-redis:6379

# MUST match backend-server exactly or sessions and tokens break.
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# Required by the config schema even though the worker serves no HTTP traffic.
STORE_CORS=https://shop.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://shop.example.com,https://api.example.com

# --- Meilisearch (search engine) ------------------------------------------
# The worker runs the product-sync subscribers, so it needs the same
# Meilisearch connection as backend-server. Use the medusa-meilisearch
# Application's internal App Name (e.g. http://medusa-meilisearch-<suffix>:7700).
MEILISEARCH_HOST=http://medusa-meilisearch:7700
MEILISEARCH_API_KEY=CHANGE_ME
MEILISEARCH_PRODUCT_INDEX_NAME=products

# Seconds to wait for backend-server to finish migrations before starting.
WORKER_START_DELAY=20
