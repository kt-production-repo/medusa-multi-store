# ===========================================================================
# Dokploy service: medusa-storefront   (Application, Dockerfile build)
#   Dockerfile Path : deploy/storefront/Dockerfile
#   Context Path    : .
#   Domain          : shop.example.com  ->  container port 8000
# ===========================================================================

# --- Build Time Arguments (Environment tab -> Build Time Arguments) --------
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, and
# check-env-variables.js aborts the build if the publishable key is missing.
# These MUST be set as Build Time Arguments, not just runtime variables.
#
# Set the SAME variables again — identical names, identical values — under
# Environment -> Environment Variables. Server-side rendering reads them from
# the real environment at runtime, where nothing is inlined.
#
# The NEXT_PUBLIC_ prefix is part of the variable name and is NOT optional.
# A bare MEDUSA_BACKEND_URL is ignored by the storefront entirely; with
# NEXT_PUBLIC_MEDUSA_BACKEND_URL missing at runtime, lib/config.ts silently
# falls back to http://localhost:9001 and every /[countryCode] page returns
# HTTP 500 ("fetch failed ... ECONNREFUSED" in the container logs).
#
# Get the key from Medusa Admin -> Settings -> API Key Management ->
# Publishable API Keys. The backend must be deployed first.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com
NEXT_PUBLIC_BASE_URL=https://shop.example.com
# Must be a country code that exists in a region. The upstream seed only
# creates EU regions (gb, de, dk, se, fr, es, it) — there is no "us". If you
# want "us", create a US region in Admin -> Settings -> Regions first.
NEXT_PUBLIC_DEFAULT_REGION=gb
# Stripe PUBLISHABLE key (pk_...), NOT the secret key. Leave empty to hide the
# Stripe payment option and fall back to manual checkout.
NEXT_PUBLIC_STRIPE_KEY=

# --- Runtime environment variables -----------------------------------------
# Mirror ALL FOUR NEXT_PUBLIC_* build args above here first (same names, same
# values), then add:
NODE_ENV=production
PORT=8000
# Secret for ISR revalidation. Generate with: openssl rand -base64 32
# This is a runtime-only variable, NOT a build arg.
REVALIDATE_SECRET=CHANGE_ME

# Optional speed-up: point the RUNTIME copy of NEXT_PUBLIC_MEDUSA_BACKEND_URL
# at the internal hostname so server-side fetches skip Traefik. The BUILD arg
# must stay the public domain either way — the build container is not on the
# app network. Requires the storefront to share a Dokploy network with
# backend-server (see README, "Networking"). Same name, prefix included:
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://medusa-backend-server:9000
